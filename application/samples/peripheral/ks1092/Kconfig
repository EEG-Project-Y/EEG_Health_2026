    int
    prompt "KS1092 SPI CS pin."
    depends on SAMPLE_SUPPORT_KS1092
    default 8

config KS1092_RESET_PIN
    int
    prompt "KS1092 RESET pin."
    depends on SAMPLE_SUPPORT_KS1092
    default 6

